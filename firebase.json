{
  "functions": [
    {
      "source": ".",
      "codebase": "backend",
      "ignore": [
        ".firebase",
        ".git",
        ".github",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "node_modules"
      ],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099,
      "host": "0.0.0.0"
    },
    "functions": {
      "port": 5001,
      "host": "0.0.0.0"
    },
    "ui": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 4000
    },
    "singleProjectMode": true
  }
}
