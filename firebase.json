{
  "functions": {
    "source": ".",
    "ignore": [
      ".firebase",
      ".git",
      ".github",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "node_modules"
    ],
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
