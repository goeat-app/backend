# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Local Storage (development)
UPLOADS_PATH=./uploads

# Environment
NODE_ENV=development

# Firebase Auth Emulator (local development only)
# Set this to point firebase-admin to the local Auth emulator instead of production.
# Start the emulator first with: npm run emulators:auth
# Then run the backend with: npm run start:emulator
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_PROJECT_ID=demo-goeat
