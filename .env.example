# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Local Storage (development)
UPLOADS_PATH=./uploads

# Environment
NODE_ENV=development
RECOMMENDER_SYSTEM_URL=http://localhost:5000

# Firebase Auth Emulator (local development only)
# Set this to point firebase-admin to the local Auth emulator instead of production.
# Then run the backend with: npm run start:local:firebase
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
EMULATOR_PROJECT_ID=demo-goeat
